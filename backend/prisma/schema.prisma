// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Model - For customers
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  avatar    String?
  bio       String?    @db.Text
  address   String?
  city      String?
  role      String     @default("user") // user, provider, admin
  status    String     @default("active") // active, inactive, suspended
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  bookings  Booking[]
  reviews   Review[]
  notifications Notification[]
  provider  Provider?
  messages  Message[] // Messages sent by this user
  messagesReceived Message[] @relation("MessagesReceived") // Messages received by this user
  supportTickets SupportTicket[] // Support tickets created by user
  ticketMessages TicketMessage[] // Messages sent in support tickets
}

// Provider Model - For service providers
model Provider {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String     // Electrician, Plumber, etc.
  bio         String?
  experience  Int?       // Years of experience
  rating      Float      @default(0)
  verified    Boolean    @default(false)
  documents   String?    // JSON array of document paths
  isAvailable Boolean    @default(true) // provider pause toggle (server-side)
  weeklyOff   String?    // JSON array of weekday numbers 0-6 the provider never works, e.g. "[6]"
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  services    Service[]
  bookings    Booking[]
  reviews     Review[]
  notifications Notification[]
  dayOffs     ProviderDayOff[]
}

// Service Model - Services offered by providers
model Service {
  id          String     @id @default(cuid())
  providerId  String
  provider    Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  duration    Int?       // In minutes
  availability String?   // JSON array of available time slots
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  bookings    Booking[]
}

// Booking Model
model Booking {
  id          String     @id @default(cuid())
  bookingRef  String     @unique
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId  String
  provider    Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service    @relation(fields: [serviceId], references: [id])
  
  status      String     @default("pending") // pending, confirmed, in_progress, completed, cancelled
  date        DateTime
  startTime   String
  duration    String     // "1 hour", "2 hours", etc.
  location    String
  notes       String?
  
  totalAmount Float
  paymentMethod String?
  paymentStatus String @default("unpaid") // unpaid, paid, refund_requested, refunded

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  review      Review?
  notifications Notification[]
  messages    Message[]
  payments    Payment[]

  @@index([providerId, date, startTime])
  @@index([userId, status])
  @@index([status, date])
}

// Notification Model - For provider booking requests
model Notification {
  id          String     @id @default(cuid())
  bookingId   String?
  booking     Booking?   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  providerId  String
  provider    Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        String     // "booking_request", "booking_accepted", "booking_rejected", etc.
  title       String
  message     String
  status      String     @default("unread") // unread, read
  action      String?    // "accept", "reject", "cancel"
  actionDate  DateTime?
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, status])
  @@index([providerId, status])
  @@index([bookingId])
}

// Review Model
model Review {
  id          String     @id @default(cuid())
  bookingId   String     @unique
  booking     Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId  String
  provider    Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  
  rating      Int        // 1-5
  comment     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Message Model - For chat between users and providers
model Message {
  id          String     @id @default(cuid())
  bookingId   String
  booking     Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User       @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  
  text        String
  attachment  String?    // URL or path to file if any
  isRead      Boolean    @default(false)
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  @@index([bookingId])
  @@index([senderId])
  @@index([receiverId])
  @@index([bookingId, createdAt])
  @@index([receiverId, isRead])
}

// Support Ticket Model - For users/providers to contact admin
model SupportTicket {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  description String     @db.Text
  category    String     // "bug", "feedback", "payment", "other"
  priority    String     @default("medium") // "low", "medium", "high"
  status      String     @default("open") // "open", "in_progress", "resolved", "closed"
  
  messages    TicketMessage[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  resolvedAt  DateTime?
}

// Ticket Message Model - For back-and-forth communication
model TicketMessage {
  id          String     @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  message     String     @db.Text
  attachment  String?    // URL or path to file if any
  
  createdAt   DateTime   @default(now())
}

// Payment ledger — one row per claim/verification attempt.
// Lets customers, providers and admins see WHO claimed WHAT ref,
// whether eSewa/Khalti verified it live, and how refunds resolve.
model Payment {
  id          String     @id @default(cuid())
  bookingId   String
  booking     Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId      String     // customer who paid / claimed
  method      String     // cash, esewa, khalti, bank
  amount      Float
  reference   String?    // wallet txn id / bank ref (null for cash)
  status      String     @default("claimed") // claimed, verified, failed, refund_requested, refunded
  verifyMode  String     @default("format") // format, esewa_api, khalti_api, manual
  verifyNote  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([bookingId])
  @@index([userId, status])
  @@index([reference])
}

// Provider time off — full days and/or named slots the provider blocks.
// Checked on booking create + reschedule to prevent double-booking.
model ProviderDayOff {
  id          String     @id @default(cuid())
  providerId  String
  provider    Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  date        DateTime   // calendar day (time ignored, YYYY-MM-DD)
  slots       String?    // JSON array of blocked startTime labels; null/empty = whole day
  reason      String?
  createdAt   DateTime   @default(now())

  @@unique([providerId, date])
  @@index([providerId, date])
}

// Refresh tokens — long-lived, rotatable, revocable.
// Access tokens (JWT) stay short; clients swap a refresh token for a new
// pair via POST /api/auth/refresh. Only sha256 hashes are stored.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// SMS OTP codes for phone login (Sparrow SMS). Only sha256 hashes stored,
// 5-minute TTL, 5 attempts max, then the code is dead.
model OtpCode {
  id        String    @id @default(cuid())
  phone     String    @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

// Saved providers — server-side favorites, synced with the app's
// localStorage cache (offline-first, merged on login).
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  providerId String
  createdAt  DateTime @default(now())

  @@unique([userId, providerId])
  @@index([userId])
  @@index([providerId])
}

// Promo / coupon codes managed from the admin dashboard.
// Static codes in utils/promos.js remain as built-in fallbacks.
model PromoCode {
  id               String    @id @default(cuid())
  code             String    @unique
  label            String
  type             String    // pct | flat
  value            Float
  maxOff           Float?
  minTotal         Float     @default(0)
  firstBookingOnly Boolean   @default(false)
  active           Boolean   @default(true)
  expiresAt        DateTime?
  usageLimit       Int?
  usedCount        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([active])
}

// Admin Model
model Admin {
  id          String     @id @default(cuid())
  email       String     @unique
  password    String
  name        String
  permissions String?    // JSON array of permissions
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Profile audit log — every customer/provider/admin profile edit lands here
// so the admin dashboard can show WHO changed WHAT and WHEN.
// `changes` is a JSON object: { field: { from, to } } for the edited fields.
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String   // user who made the change (or admin id)
  actorName    String?  // denormalized "First Last" at write time
  actorRole    String   @default("user") // user, provider, admin
  targetUserId String   // user whose profile changed
  targetName   String?
  action       String   // profile_updated, provider_profile_updated, avatar_updated, admin_user_updated, admin_provider_updated
  changes      String?  // JSON string of { field: { from, to } }
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
