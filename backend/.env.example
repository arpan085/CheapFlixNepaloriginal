# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cheapflix_nepal?schema=public"

# JWT Secret — MUST be 32+ random chars in every environment.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating invalidates all sessions: announce a maintenance window first.
JWT_SECRET="your_super_secret_jwt_key_here_MIN_32_CHARS"
# Access tokens live this long (refresh tokens last 30 days and rotate).
# The app auto-refreshes, so 12h (or 15m for max security) is safe.
JWT_EXPIRE="12h"

# Public frontend origin(s) for CORS + password-reset links (no trailing slash).
# CORS_ORIGIN is the production CORS allow-list (comma-separated, no "*").
# FRONTEND_URLS is comma-separated for extra domains (preview deploys etc).
CORS_ORIGIN="http://localhost:5500"
FRONTEND_URL="http://localhost:5500"
FRONTEND_URLS=""

# Google login (get the client ID from Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=""

# Server
PORT=5000
NODE_ENV="development"

# Email via Resend HTTP API (no SMTP needed) — powers password-reset mails.
# Get a free key at https://resend.com/api-keys (verify your domain, or
# test with the default onboarding@resend.dev sender).
RESEND_API_KEY=""
MAIL_FROM="Cheapflix Nepal <namaste@cheapflixnepal.live>"

# Cloud uploads (Cloudinary unsigned preset) — only used if Neon
# Object Storage below is NOT configured. Create an unsigned preset at
# https://console.cloudinary.com/settings/upload
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""

# Neon Object Storage (S3-compatible) — preferred upload target.
# `neon link` pulls these into root .env.local automatically; copy them
# into backend/.env for local dev, or set them on your host (Render etc).
# NEVER commit real values. If a key ever leaks in chat/logs, revoke it in
# Neon Console -> Storage -> credentials and generate a fresh one.
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="assets"

# SMS OTP login via Sparrow SMS (https://sparrowsms.com) — Nepali mobiles.
# Without a token, OTP codes are logged server-side (dev mode only).
SPARROW_SMS_TOKEN=""
SPARROW_SMS_FROM="Cheapflix"
# Booking lifecycle SMS (credits cost money — default OFF).
# Comma-separated events: booking_request, booking_confirmed,
# booking_cancelled, booking_completed. Email needs no flag.
NOTIFY_SMS_EVENTS=""

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR="./uploads"

# Payments — eSewa ePay v2 (get from merchant dashboard)
ESEWA_MERCHANT=""
ESEWA_SECRET_KEY=""
ESEWA_MODE="test"
# Payments — Khalti (get from merchant dashboard)
KHALTI_SECRET_KEY=""
KHALTI_MODE="test"
# Optional bank hint shown to customers choosing bank transfer
BANK_ACCOUNT_HINT=""
